# Telegram Bot（@BotFather で発行したトークン）
TELEGRAM_BOT_TOKEN=

# 応答を許可するチャットID（カンマ区切り）。空だと全メッセージ拒否。
# 自分のIDはボットに /start を送ると未許可メッセージ内に表示される。
ALLOWED_CHAT_IDS=

# --- 以下は通常デフォルトのままでよい ---
# Claude Code CLI のパス
#CLAUDE_BIN=claude
# 生成タイムアウト（秒）
#CLAUDE_TIMEOUT_SEC=1200
# 公開URLのベース
#BASE_URL=https://major-senzu.github.io/claude-artifacts/mock-studio/pages
# テスト用: 1でClaudeを呼ばずダミー生成 / 1でgit push をスキップ
#MOCK_MODE=0
#DRY_RUN=0
