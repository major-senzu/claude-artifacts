<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ueyama.shota-all-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/major/Documents/00_Shota-all/05_automation/backup/backup.sh</string>
    </array>

    <!-- 毎日 03:00 に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Mac がスリープ中に実行時刻を逃した場合、起動後に実行 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/major/Backups/00_Shota-all-backup/_logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/major/Backups/00_Shota-all-backup/_logs/launchd-stderr.log</string>
</dict>
</plist>
